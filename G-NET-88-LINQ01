#region Question 12
// Sort first by word length and then by a
// case-insensitive sort of the words in an array.

string[] Arr =
{
    "aPPLE",
    "AbAcUs",
    "bRaNcH",
    "BlUeBeRrY",
    "ClOvEr",
    "cHeRry"
};

var q12 = Arr
    .OrderBy(word => word.Length)
    .ThenBy(word => word, StringComparer.OrdinalIgnoreCase);

foreach (var word in q12)
{
    Console.WriteLine(word);
}
#endregion


#region Question 13
// Create a list of all words in the array whose second letter
// is 'i', reversed from the order in the original array.

var q13 = Arr
    .Where(word => word.Length > 1
        && char.ToLowerInvariant(word[1]) == 'i')
    .Reverse()
    .ToList();

foreach (var word in q13)
{
    Console.WriteLine(word);
}
#endregion
