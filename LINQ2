
using System;
using System.Linq;
using System.Collections.Generic;

class Product
{
    public int ProductID { get; set; }
    public string ProductName { get; set; }
    public string Category { get; set; }
    public decimal UnitPrice { get; set; }
    public int UnitsInStock { get; set; }

    public override string ToString()
    {
        return $"{ProductID} - {ProductName} - {Category} - ${UnitPrice} - Stock: {UnitsInStock}";
    }
}

class Order
{
    public int OrderID { get; set; }
    public decimal Total { get; set; }
}

class Customer
{
    public string CompanyName { get; set; }
    public string Country { get; set; }
    public List<Order> Orders { get; set; } = new List<Order>();
}

class Program
{
    static void Main(string[] args)
    {
        var ProductList = new List<Product>
        {
            new Product { ProductID = 1, ProductName = "Chai", Category = "Beverages", UnitPrice = 18m, UnitsInStock = 39 },
            new Product { ProductID = 2, ProductName = "Chang", Category = "Beverages", UnitPrice = 19m, UnitsInStock = 17 },
            new Product { ProductID = 3, ProductName = "Aniseed Syrup", Category = "Condiments", UnitPrice = 10m, UnitsInStock = 13 },
            new Product { ProductID = 4, ProductName = "Chef Anton", Category = "Condiments", UnitPrice = 22m, UnitsInStock = 0 },
            new Product { ProductID = 5, ProductName = "Grandma Cookies", Category = "Confections", UnitPrice = 25m, UnitsInStock = 20 },
            new Product { ProductID = 6, ProductName = "Chocolate", Category = "Confections", UnitPrice = 12m, UnitsInStock = 30 },
            new Product { ProductID = 7, ProductName = "Dried Pears", Category = "Produce", UnitPrice = 30m, UnitsInStock = 15 },
            new Product { ProductID = 8, ProductName = "Cranberry Sauce", Category = "Condiments", UnitPrice = 40m, UnitsInStock = 10 },
            new Product { ProductID = 9, ProductName = "Mishi Kobe", Category = "Meat", UnitPrice = 97m, UnitsInStock = 5 },
            new Product { ProductID = 10, ProductName = "Ikura", Category = "Seafood", UnitPrice = 31m, UnitsInStock = 20 },
            new Product { ProductID = 11, ProductName = "Queso Cabrales", Category = "Dairy", UnitPrice = 21m, UnitsInStock = 12 },
            new Product { ProductID = 12, ProductName = "Queso Manchego", Category = "Dairy", UnitPrice = 38m, UnitsInStock = 8 },
            new Product { ProductID = 13, ProductName = "Konbu", Category = "Seafood", UnitPrice = 6m, UnitsInStock = 24 },
            new Product { ProductID = 14, ProductName = "Tofu", Category = "Produce", UnitPrice = 23m, UnitsInStock = 35 },
            new Product { ProductID = 15, ProductName = "Genen Shouyu", Category = "Condiments", UnitPrice = 15m, UnitsInStock = 0 },
            new Product { ProductID = 16, ProductName = "Pavlova", Category = "Confections", UnitPrice = 17m, UnitsInStock = 10 },
            new Product { ProductID = 17, ProductName = "Carnarvon Tigers", Category = "Seafood", UnitPrice = 62m, UnitsInStock = 5 },
            new Product { ProductID = 18, ProductName = "Raclette", Category = "Dairy", UnitPrice = 55m, UnitsInStock = 4 },
            new Product { ProductID = 19, ProductName = "Thuringer", Category = "Meat", UnitPrice = 123m, UnitsInStock = 3 },
            new Product { ProductID = 20, ProductName = "Boston Crab Meat", Category = "Seafood", UnitPrice = 20m, UnitsInStock = 0 }
        };

        var CustomerList = new List<Customer>
        {
            new Customer { CompanyName = "Alpha", Country = "Germany", Orders = new List<Order> { new Order { OrderID = 1, Total = 1200m }, new Order { OrderID = 2, Total = 800m } } },
            new Customer { CompanyName = "Beta", Country = "France", Orders = new List<Order> { new Order { OrderID = 3, Total = 2500m } } },
            new Customer { CompanyName = "Gamma", Country = "Germany", Orders = new List<Order> { new Order { OrderID = 4, Total = 1500m } } },
            new Customer { CompanyName = "Delta", Country = "UK", Orders = new List<Order> { new Order { OrderID = 5, Total = 3000m } } },
            new Customer { CompanyName = "Epsilon", Country = "France", Orders = new List<Order> { new Order { OrderID = 6, Total = 900m } } },
            new Customer { CompanyName = "Zeta", Country = "Spain", Orders = new List<Order>() }
        };

        Console.WriteLine("\n1. Top 3 Most Expensive Products");
        var result1 = ProductList.OrderByDescending(p => p.UnitPrice).Take(3);
        foreach (var p in result1) Console.WriteLine(p);

        Console.WriteLine("\n2. Page 2, Page Size = 5");
        var result2 = ProductList.Skip(5).Take(5);
        foreach (var p in result2) Console.WriteLine(p);

        Console.WriteLine("\n3. Products with Price < 25");
        var result3 = ProductList.OrderBy(p => p.UnitPrice).TakeWhile(p => p.UnitPrice < 25m);
        foreach (var p in result3) Console.WriteLine(p);

        Console.WriteLine("\n4. Are All Seafood Products In Stock?");
        bool result4 = ProductList.Where(p => p.Category == "Seafood").All(p => p.UnitsInStock > 0);
        Console.WriteLine(result4);

        Console.WriteLine("\n5. Does IDs Contain 9?");
        int[] ids = { 3, 9, 13, 18 };
        Console.WriteLine(ids.Contains(9));

        Console.WriteLine("\n6. Group Products by Category and Count");
        var result6 = ProductList.GroupBy(p => p.Category);
        foreach (var g in result6)
            Console.WriteLine($"{g.Key}: {g.Count()} products");

        Console.WriteLine("\n7. Product Names Grouped by Category");
        var result7 = ProductList.GroupBy(p => p.Category)
            .Select(g => new { Category = g.Key, Names = g.Select(p => p.ProductName) });
        foreach (var g in result7)
        {
            Console.WriteLine(g.Category);
            foreach (var name in g.Names) Console.WriteLine(name);
        }

        Console.WriteLine("\n8. Categories with More Than 3 Products");
        var result8 = ProductList.GroupBy(p => p.Category)
            .Where(g => g.Count() > 3)
            .Select(g => new { Category = g.Key, Count = g.Count() });
        foreach (var g in result8)
            Console.WriteLine($"{g.Category}: {g.Count}");

        Console.WriteLine("\n9. Group Customers by Country (Query Syntax)");
        var result9 =
            from c in CustomerList
            group c by c.Country into Countries
            select new
            {
                Country = Countries.Key,
                Count = Countries.Count(),
                TotalOrderValue = Countries.Sum(c => c.Orders.Sum(o => o.Total))
            };
        foreach (var item in result9)
            Console.WriteLine($"{item.Country} - Customers: {item.Count} - Orders: {item.TotalOrderValue}");

        Console.WriteLine("\n10. Total Units in Stock");
        Console.WriteLine(ProductList.Sum(p => p.UnitsInStock));

        Console.WriteLine("\n11. Cheapest and Most Expensive Prices");
        Console.WriteLine($"Cheapest: ${ProductList.Min(p => p.UnitPrice)}");
        Console.WriteLine($"Most Expensive: ${ProductList.Max(p => p.UnitPrice)}");

        Console.WriteLine("\n12. Distinct Categories");
        var result12 = ProductList.Select(p => p.Category).Distinct();
        foreach (var category in result12) Console.WriteLine(category);

        Console.WriteLine("\n13. IDs in SetA but Not SetB");
        int[] setA = { 1, 3, 5, 7, 9, 11, 13 };
        int[] setB = { 3, 6, 9, 12, 15, 13 };
        foreach (var id in setA.Except(setB)) Console.WriteLine(id);

        Console.WriteLine("\n14. Countries in List1 but Not List2");
        string[] list1 = { "Germany", "France", "UK", "Spain" };
        string[] list2 = { "france", "SPAIN", "Italy" };
        foreach (var country in list1.Except(list2, StringComparer.OrdinalIgnoreCase))
            Console.WriteLine(country);

        Console.WriteLine("\n15. Dictionary and Product ID = 18");
        var result15 = ProductList.ToDictionary(p => p.ProductID);
        Console.WriteLine(result15[18]);

        Console.WriteLine("\n16. First Product with Price > 50");
        var result16 = ProductList.First(p => p.UnitPrice > 50m);
        Console.WriteLine(result16);

        Console.WriteLine("\n17. First Product with Price > 500");
        var result17 = ProductList.FirstOrDefault(p => p.UnitPrice > 500m);
        Console.WriteLine(result17 == null ? "null" : result17.ToString());

        Console.WriteLine("\n18. Multiplication Table Row for 7");
        var result18 = Enumerable.Range(1, 10).Select(n => $"7 x {n} = {7 * n}");
        foreach (var item in result18) Console.WriteLine(item);

        Console.WriteLine("\n19. Even Numbers Between 1 and 30");
        var result19 = Enumerable.Range(1, 30).Where(n => n % 2 == 0);
        foreach (var n in result19) Console.WriteLine(n);

        Console.WriteLine("\n20. First 3 Product Names + First 3 Customer Names");
        var result20 = ProductList.Take(3).Select(p => p.ProductName)
            .Concat(CustomerList.Take(3).Select(c => c.CompanyName));
        foreach (var name in result20) Console.WriteLine(name);

        Console.WriteLine("\n21. Pair Products with Customers by Position");
        var result21 = ProductList.Zip(CustomerList,
            (p, c) => $"{p.ProductName} sold to {c.CompanyName}");
        foreach (var item in result21) Console.WriteLine(item);
    }
}
